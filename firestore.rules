rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userHouseholdIds() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userDoc().data.householdIds is list
        ? userDoc().data.householdIds
        : [];
    }

    function belongsToHousehold(householdId) {
      return signedIn() && (householdId in userHouseholdIds() || isHouseholdOwner(householdId));
    }

    function addedHouseholdIds() {
      return !('householdIds' in request.resource.data) ? [] :
             !('householdIds' in resource.data) ? request.resource.data.householdIds :
             request.resource.data.householdIds.removeAll(resource.data.householdIds);
    }

    function isHouseholdOwner(householdId) {
      return exists(/databases/$(database)/documents/households/$(householdId)) &&
             get(/databases/$(database)/documents/households/$(householdId)).data.ownerUid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId;
      // SECURITY FIX: Prevent householdIds self-escalation.
      // We check that any newly added household ID must be owned by the user.
      allow update: if signedIn()
                    && request.auth.uid == userId
                    && (
                         !('householdIds' in request.resource.data)
                         ||
                         (
                           addedHouseholdIds().size() == 0
                           ||
                           (addedHouseholdIds().size() == 1 &&
                            isHouseholdOwner(addedHouseholdIds()[0]))
                         )
                       );
      allow delete: if false;
    }

    match /households/{householdId} {
      allow read: if belongsToHousehold(householdId);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      // FIX: Prevent owner from locking themselves out by modifying ownerUid
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid &&
                    request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /medicines/{medicineId} {
      allow read: if belongsToHousehold(resource.data.householdId);
      allow create: if belongsToHousehold(request.resource.data.householdId);
      // FIX: Prevent transferring medicines between households
      allow update: if belongsToHousehold(resource.data.householdId) && 
                    request.resource.data.householdId == resource.data.householdId;
      allow delete: if belongsToHousehold(resource.data.householdId);
    }

    match /reminders/{reminderId} {
      allow read: if belongsToHousehold(resource.data.householdId);
      allow create: if belongsToHousehold(request.resource.data.householdId);
      // FIX: Prevent transferring reminders
      allow update: if belongsToHousehold(resource.data.householdId) && 
                    request.resource.data.householdId == resource.data.householdId;
      allow delete: if belongsToHousehold(resource.data.householdId);
    }

    match /members/{memberId} {
      allow read: if belongsToHousehold(resource.data.householdId);
      allow create: if belongsToHousehold(request.resource.data.householdId);
      // FIX: Prevent transferring members
      allow update: if belongsToHousehold(resource.data.householdId) && 
                    request.resource.data.householdId == resource.data.householdId;
      allow delete: if belongsToHousehold(resource.data.householdId);
    }

    match /caregivers/{caregiverId} {
      allow read: if belongsToHousehold(resource.data.householdId);
      allow create: if belongsToHousehold(request.resource.data.householdId);
      // FIX: Prevent transferring caregivers
      allow update: if belongsToHousehold(resource.data.householdId) && 
                    request.resource.data.householdId == resource.data.householdId;
      allow delete: if belongsToHousehold(resource.data.householdId);
    }

    // Emergency contacts stored per household — any member can read/write
    match /emergencyContacts/{householdId} {
      allow read: if belongsToHousehold(householdId);
      allow write: if belongsToHousehold(householdId);
    }
  }
}
